{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "info",
    "timestamp": true,
    "output": "/var/lib/sing-box/diagnostic-main.log"
  },
  "certificate_providers": [
    {
      "type": "acme",
      "tag": "le-ip",
      "domain": [
        "198.51.100.20"
      ],
      "data_directory": "/var/lib/sing-box/acme",
      "default_server_name": "198.51.100.20",
      "provider": "letsencrypt",
      "profile": "shortlived",
      "key_type": "p256",
      "disable_http_challenge": true,
      "disable_tls_alpn_challenge": false
    }
  ],
  "inbounds": [
    {
      "type": "trojan",
      "tag": "trojan-in",
      "listen": "0.0.0.0",
      "listen_port": 443,
      "users": [
        {
          "name": "EXAMPLE_USER_1",
          "password": "EXAMPLE_SECRET"
        },
        {
          "name": "EXAMPLE_USER_2",
          "password": "EXAMPLE_SECRET"
        },
        {
          "name": "EXAMPLE_USER_3",
          "password": "EXAMPLE_SECRET"
        },
        {
          "name": "EXAMPLE_USER_4",
          "password": "EXAMPLE_SECRET"
        },
        {
          "name": "EXAMPLE_USER_5",
          "password": "EXAMPLE_SECRET"
        },
        {
          "name": "EXAMPLE_USER_6",
          "password": "EXAMPLE_SECRET"
        },
        {
          "name": "EXAMPLE_USER_7",
          "password": "EXAMPLE_SECRET"
        },
        {
          "name": "EXAMPLE_USER_8",
          "password": "EXAMPLE_SECRET"
        },
        {
          "name": "EXAMPLE_USER_9",
          "password": "EXAMPLE_SECRET"
        },
        {
          "name": "EXAMPLE_USER_10",
          "password": "EXAMPLE_SECRET"
        },
        {
          "name": "EXAMPLE_USER_11",
          "password": "EXAMPLE_SECRET"
        },
        {
          "name": "EXAMPLE_USER_12",
          "password": "EXAMPLE_SECRET"
        },
        {
          "name": "EXAMPLE_USER_13",
          "password": "EXAMPLE_SECRET"
        },
        {
          "name": "EXAMPLE_USER_14",
          "password": "EXAMPLE_SECRET"
        },
        {
          "name": "EXAMPLE_USER_15",
          "password": "EXAMPLE_SECRET"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "198.51.100.20",
        "alpn": [
          "http/1.1"
        ],
        "min_version": "1.2",
        "certificate_provider": "le-ip"
      },
      "fallback": {
        "server": "127.0.0.1",
        "server_port": 8080
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "socks",
      "tag": "xo-shared",
      "server": "192.0.2.10",
      "server_port": 43142,
      "version": "5",
      "username": "EXAMPLE_SECRET",
      "password": "EXAMPLE_SECRET",
      "network": "tcp"
    },
    {
      "type": "direct",
      "tag": "EXAMPLE_USER_14"
    },
    {
      "type": "socks",
      "tag": "EXAMPLE_USER_15",
      "server": "192.0.2.10",
      "server_port": 43142,
      "version": "5",
      "username": "EXAMPLE_SECRET",
      "password": "EXAMPLE_SECRET",
      "network": "tcp"
    }
  ],
  "route": {
    "rules": [
      {
        "network": "udp",
        "action": "reject",
        "method": "drop"
      },
      {
        "action": "sniff",
        "sniffer": [
          "http",
          "tls"
        ],
        "timeout": "500ms"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "auth_user": [
              "EXAMPLE_USER_13",
              "EXAMPLE_USER_14",
              "EXAMPLE_USER_15"
            ]
          },
          {
            "rule_set": [
              "ai-always-xo"
            ]
          }
        ],
        "action": "route",
        "outbound": "EXAMPLE_USER_15"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "auth_user": [
              "EXAMPLE_USER_13",
              "EXAMPLE_USER_14",
              "EXAMPLE_USER_15"
            ]
          },
          {
            "auth_user": [
              "EXAMPLE_USER_14"
            ]
          }
        ],
        "action": "route",
        "outbound": "EXAMPLE_USER_14"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "auth_user": [
              "EXAMPLE_USER_13",
              "EXAMPLE_USER_14",
              "EXAMPLE_USER_15"
            ]
          },
          {
            "auth_user": [
              "EXAMPLE_USER_15"
            ]
          }
        ],
        "action": "route",
        "outbound": "EXAMPLE_USER_15"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "auth_user": [
              "EXAMPLE_USER_13",
              "EXAMPLE_USER_14",
              "EXAMPLE_USER_15"
            ]
          },
          {
            "auth_user": [
              "EXAMPLE_USER_13"
            ],
            "rule_set": [
              "openai-official"
            ]
          }
        ],
        "action": "route",
        "outbound": "EXAMPLE_USER_15"
      },
      {
        "auth_user": [
          "EXAMPLE_USER_13",
          "EXAMPLE_USER_14",
          "EXAMPLE_USER_15"
        ],
        "action": "route",
        "outbound": "EXAMPLE_USER_14"
      },
      {
        "rule_set": [
          "ai-always-xo"
        ],
        "action": "route",
        "outbound": "xo-shared"
      },
      {
        "auth_user": [
          "EXAMPLE_USER_2",
          "EXAMPLE_USER_5",
          "EXAMPLE_USER_8",
          "EXAMPLE_USER_11"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "auth_user": [
          "EXAMPLE_USER_3",
          "EXAMPLE_USER_6",
          "EXAMPLE_USER_9",
          "EXAMPLE_USER_12"
        ],
        "action": "route",
        "outbound": "xo-shared"
      },
      {
        "auth_user": [
          "EXAMPLE_USER_1",
          "EXAMPLE_USER_4",
          "EXAMPLE_USER_7",
          "EXAMPLE_USER_10"
        ],
        "rule_set": [
          "openai-official"
        ],
        "action": "route",
        "outbound": "xo-shared"
      }
    ],
    "rule_set": [
      {
        "type": "local",
        "tag": "openai-official",
        "format": "source",
        "path": "/etc/sing-box/rules/openai-official.json"
      },
      {
        "type": "local",
        "tag": "ai-always-xo",
        "format": "source",
        "path": "/etc/sing-box/rules/ai-always-xo.json"
      }
    ],
    "final": "direct",
    "auto_detect_interface": true
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "secret": "EXAMPLE_SECRET",
      "access_control_allow_origin": [],
      "access_control_allow_private_network": false
    }
  }
}
