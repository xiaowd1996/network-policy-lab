[Unit]
Description=Passive diagnostic TCP transport observer
After=sing-box.service proxy-diagnostic-tcp-collector.service
[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/proxy-diagnostic/transport-observer.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/proxy-diagnostic-transport
MemoryMax=96M
CPUQuota=10%
TasksMax=16
[Install]
WantedBy=multi-user.target
