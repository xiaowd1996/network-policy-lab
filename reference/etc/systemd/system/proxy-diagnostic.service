[Unit]
Description=Isolated private proxy diagnostic
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/local/bin/sing-box run -c /etc/proxy-diagnostic/config.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
MemoryMax=192M
TasksMax=64
[Install]
WantedBy=multi-user.target
