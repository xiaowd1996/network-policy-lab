[Unit]
Description=33 wrapped relay to independent new XO
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sing-box run -c /root/private-relay-xo2-20261014/server.json
Restart=on-failure
RestartSec=3
UMask=0077
Nice=5
CPUWeight=50
MemoryMax=infinity
LimitNOFILE=infinity
TasksMax=infinity
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/private-relay-xo2-20261014
Environment=GOMAXPROCS=2

[Install]
WantedBy=multi-user.target
