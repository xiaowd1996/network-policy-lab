[Unit]
Description=Auth scoped diagnostic TCP collector
After=sing-box.service
Requires=sing-box.service
[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/proxy-diagnostic/tcp-collect.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
MemoryMax=128M
TasksMax=32
[Install]
WantedBy=multi-user.target
