[Unit]
Description=Metadata-only 33 wrapper TCP observer
After=network.target


[Service]
Type=simple
ExecStart=/usr/bin/python3 /root/private-relay-wrap/wrap-monitor.py
Restart=on-failure
RestartSec=5
UMask=0077
Nice=5
CPUWeight=50
MemoryMax=infinity
LimitNOFILE=infinity
TasksMax=infinity
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/proxy-relay-wrap
Environment=GOMAXPROCS=2
MemoryMax=96M
CPUQuota=10%
Nice=10
[Install]
WantedBy=multi-user.target
